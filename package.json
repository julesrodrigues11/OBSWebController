{
  "name": "stagehand-obs",
  "private": true,
  "license": "MIT",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "host": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node scripts/changelog.mjs release && git add CHANGELOG.md",
    "package": "npm run build && node scripts/package.mjs",
    "serve": "node host/server.mjs --dir dist"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  },
  "description": "LAN web controller for OBS Studio via obs-websocket v5",
  "engines": {
    "node": ">=22.12.0"
  }
}
